---
import fallbackProjects from '../../data/projects.json';

const username = 'gregoire-marie';
const excluded = new Set(['gregoire-marie.github.io', 'wage-plotter', 'Merlion', 'n2d', 'timeseries-clustering-vrae']);
const overrides = new Map(fallbackProjects.filter((project) => project.repo).map((project) => [project.repo, project]));
let projectList: any[] = [...fallbackProjects];

try {
  const headers: Record<string, string> = { Accept: 'application/vnd.github+json' };
  if (process.env.GITHUB_TOKEN) headers.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;
  const response = await fetch(`https://api.github.com/users/${username}/repos?per_page=100&sort=updated`, { headers });
  if (response.ok) {
    const repos = await response.json();
    const live = repos.filter((repo: any) => !excluded.has(repo.name)).map((repo: any) => {
      const override: any = overrides.get(repo.name) || {};
      return {
        ...override,
        repo: repo.name,
        title: override.title || repo.name.replace(/[-_.]+/g, ' ').replace(/\b\w/g, (letter: string) => letter.toUpperCase()),
        link: repo.html_url,
        description: override.description || repo.description || 'Open-source research and engineering project.',
        tags: override.tags?.length ? override.tags : [repo.language, ...(repo.topics || [])].filter(Boolean),
        updatedAt: repo.updated_at,
        sourcePath: repo.full_name
      };
    });
    const known = new Set(live.map((project: any) => project.repo));
    projectList = [...live, ...fallbackProjects.filter((project) => !project.repo || (!known.has(project.repo) && !excluded.has(project.repo)))];
  }
} catch {
  // The bundled project catalogue keeps local and offline builds deterministic.
}

projectList.sort((a, b) => new Date(b.updatedAt || 0).getTime() - new Date(a.updatedAt || 0).getTime());

const projects = {
  label: '03 // PROJECTS',
  heading: 'Selected open source work',
  statuses: [
    { label: 'All' },
    { label: 'Open Source', color: '#2E5090' },
    { label: 'Archived', color: '#6B7280' }
  ],
  items: projectList.map((project, index) => {
    const isRepository = Boolean(project.repo || project.link?.includes('github.com'));
    return {
      title: project.title,
      description: project.description,
      category: String(project.category || 'other').trim().toLowerCase(),
      icon: project.icon || 'gsjfryhc',
      status: project.status ?? (isRepository ? 'Open Source' : ''),
      featured: index < 4,
      links: [{
        url: project.link,
        icon: isRepository ? 'jjxzcivr' : 'vbmtnozn',
        label: isRepository ? 'GitHub' : 'Website'
      }],
      tech: (project.tags || []).slice(0, 5)
    };
  })
};

const statuses = projects.statuses || [];
const items = projects.items || [];
const categories = [
  { id: 'all', label: 'All' },
  ...Array.from(new Set(items.map((project) => project.category))).map((category) => ({
    id: category,
    label: category.charAt(0).toUpperCase() + category.slice(1)
  }))
];

// Build color map from statuses: { "Live": "#2D8A56", ... }
const statusColors: Record<string, string> = {};
statuses.forEach((s: any) => {
  if (s.color) statusColors[s.label] = s.color;
});
const defaultColor = '#6B7280';

const LI = { dark: 'primary:#1A1D23,secondary:#2E5090' };
const isModernIcon = (icon: string) => icon.includes('/');
const liSrc = (icon: string) => isModernIcon(icon)
  ? `https://media.lordicon.com/icons/${icon}.li`
  : `https://cdn.lordicon.com/${icon}.json`;
---
<section id="projects" class="py-20 md:py-28 px-6 bg-surface-sunken scroll-mt-16">
  <div class="max-w-[1000px] mx-auto">
    {(projects.label || projects.heading) && (
      <div class="reveal">
        {projects.label && <p class="text-[14px] font-mono text-accent tracking-[0.12em] uppercase mb-3">{projects.label}</p>}
        {projects.heading && (
          <h2 class="font-display text-[32px] md:text-[44px] font-bold text-ink mb-10 tracking-[-0.01em]">
            {projects.heading}
          </h2>
        )}
      </div>
    )}

    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8" id="project-filter-tabs">
        {categories.map((category) => {
          const label = category.label;
          return (
            <button
              class:list={[
                "px-3.5 py-1.5 text-[12px] font-medium rounded-full border transition-colors cursor-pointer",
                category.id === 'all'
                  ? 'bg-accent text-ink-on-dark border-accent'
                  : 'bg-transparent text-ink-secondary border-border hover:border-accent hover:text-accent'
              ]}
              data-filter={category.id}
            >
              {label}
            </button>
          );
        })}
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="projects-grid">
      {items.map((project: any, i: number) => {
        const color = statusColors[project.status] || defaultColor;
        const allLinks = project.links || [];
        const primaryUrl = allLinks[0]?.url;
        const extraLinks = allLinks.slice(1);
        return (
        <div
          class={`reveal ${i % 2 === 1 ? 'delay-1' : ''} card-glow bg-surface-raised rounded-[8px] p-5 flex flex-col overflow-hidden ${primaryUrl ? 'cursor-pointer' : ''}`}
          data-category={project.category || ''} data-featured={project.featured ? 'true' : 'false'}
          data-href={primaryUrl || undefined}>
          <div class="flex items-start justify-between mb-3">
            <lord-icon
              src={liSrc(project.icon || 'gsjfryhc')}
              trigger={isModernIcon(project.icon || '') ? 'hover' : 'morph'}
              target="[data-category]"
              colors={LI.dark}
              class="li-xl"
            ></lord-icon>
            {project.status && <span class="inline-block px-2 py-1 text-[10px] sm:text-[11px] sm:px-2.5 font-medium rounded font-mono uppercase whitespace-nowrap" style={`color: ${color}; background: ${color}15;`}>{project.status}</span>}
          </div>
          {project.title && <h3 class="font-display text-[19px] font-bold text-ink m-0 mb-1">{project.title}</h3>}
          {project.description && (
            <div class="mb-3.5">
              <p class="project-desc text-[14px] text-ink-secondary leading-[1.65] mt-0 mb-0">{project.description}</p>
              <button class="project-expand-toggle hidden text-[12px] font-medium text-accent hover:text-accent-light transition-colors cursor-pointer bg-transparent border-none p-0 mt-1">
                Read more
              </button>
            </div>
          )}
          <div class="mt-auto">
            {project.tech?.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {project.tech.map((t: string) => (
                  <span class="inline-block px-2 py-1 text-[11px] font-medium rounded bg-accent-wash text-accent font-mono">{t}</span>
                ))}
              </div>
            )}
            {extraLinks.length > 0 && (
              <div class="flex items-center gap-3 flex-wrap mt-3.5 pt-3.5 border-t border-border">
                {extraLinks.map((link: any) => (
                  <a href={link.url} target="_blank" rel="noopener" class="project-extra-link inline-flex items-center gap-1.5 text-[12px] font-medium text-ink-tertiary hover:text-accent transition-colors no-underline" aria-label={link.label || ''}>
                    <lord-icon src={liSrc(link.icon)} trigger="morph" colors={LI.dark} class="li-sm"></lord-icon>
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
        );
      })}
    </div>

    <div class="flex justify-center mt-7" id="projects-expand-wrap">
      <button id="projects-expand-btn" class="inline-flex items-center gap-2 px-4 py-2 text-[13px] font-medium text-ink-secondary hover:text-accent transition-colors cursor-pointer bg-transparent border border-border rounded-full hover:border-accent">
        More projects
        <lord-icon src={liSrc('gupcdncx')} trigger="morph" colors={LI.dark} class="li-md" id="expand-arrow"></lord-icon>
      </button>
    </div>
  </div>
</section>

<script>
  // Description expand/collapse — bind once, check truncation after visible
  const boundToggles = new WeakSet();

  function initDescToggles() {
    document.querySelectorAll('.project-desc').forEach(desc => {
      const toggle = desc.parentElement?.querySelector('.project-expand-toggle') as HTMLButtonElement | null;
      if (!toggle) return;

      const el = desc as HTMLElement;
      const card = el.closest('[data-category]') as HTMLElement | null;

      // Skip cards that are hidden (scrollHeight is 0)
      if (card && card.style.display === 'none') return;

      // Check if text is actually truncated
      if (el.scrollHeight > el.clientHeight + 2) {
        toggle.classList.remove('hidden');
      } else {
        toggle.classList.add('hidden');
      }

      // Only bind click once per toggle
      if (boundToggles.has(toggle)) return;
      boundToggles.add(toggle);

      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isExpanded = el.classList.contains('expanded');
        el.classList.toggle('expanded');
        toggle.textContent = isExpanded ? 'Read more' : 'Show less';
      });
    });
  }

  const filterBtns = document.querySelectorAll('#project-filter-tabs button');
  const projectCards = Array.from(document.querySelectorAll('#projects-grid > div'));

  // Make cards with data-href clickable
  projectCards.forEach(card => {
    const href = card.getAttribute('data-href');
    if (!href) return;
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button, .project-extra-link, .project-expand-toggle')) return;
      window.open(href, '_blank', 'noopener');
    });
  });

  const expandBtn = document.getElementById('projects-expand-btn');
  const expandWrap = document.getElementById('projects-expand-wrap');
  let expanded = false;
  let activeFilter = 'all';
  const MAX_VISIBLE = 4;

  function applyVisibility() {
    let matchCount = 0;
    projectCards.forEach(function(card) {
      var el = card as HTMLElement;
      var matches = activeFilter === 'all' || el.getAttribute('data-category') === activeFilter;
      if (!matches) {
        el.style.display = 'none';
        return;
      }
      matchCount++;
      if (!expanded && matchCount > MAX_VISIBLE) {
        el.style.display = 'none';
      } else {
        el.style.display = '';
        el.classList.remove('visible');
        void el.offsetWidth;
        el.classList.add('visible');
      }
    });
    if (expandWrap) {
      (expandWrap as HTMLElement).style.display = matchCount > MAX_VISIBLE ? '' : 'none';
    }
    if (expandBtn) {
      const style = getComputedStyle(document.documentElement);
      const inkColor = style.getPropertyValue('--color-ink').trim();
      const accentColor = style.getPropertyValue('--color-accent').trim();
      const colors = `primary:${inkColor},secondary:${accentColor}`;
      expandBtn.innerHTML = expanded
        ? `Less projects <lord-icon src="https://cdn.lordicon.com/gupcdncx.json" trigger="morph" colors="${colors}" class="li-md" style="transform:rotate(180deg)"></lord-icon>`
        : `More projects <lord-icon src="https://cdn.lordicon.com/gupcdncx.json" trigger="morph" colors="${colors}" class="li-md"></lord-icon>`;
    }

    // Re-animate icons + re-check desc toggles after cards are visible
    setTimeout(() => {
      document.querySelectorAll('#projects-grid lord-icon').forEach(function(icon: any) {
        var card = icon.closest('[data-category]');
        if (card && card.style.display !== 'none' && icon.playerInstance) {
          icon.playerInstance.playFromStart();
        }
      });
      initDescToggles();
    }, 150);
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.getAttribute('data-filter') || 'all';
      expanded = false;
      filterBtns.forEach(b => {
        b.classList.remove('bg-accent', 'text-ink-on-dark', 'border-accent');
        b.classList.add('bg-transparent', 'text-ink-secondary', 'border-border');
      });
      btn.classList.remove('bg-transparent', 'text-ink-secondary', 'border-border');
      btn.classList.add('bg-accent', 'text-ink-on-dark', 'border-accent');
      applyVisibility();
    });
  });

  if (expandBtn) {
    expandBtn.addEventListener('click', () => {
      expanded = !expanded;
      applyVisibility();
    });
  }

  applyVisibility();
</script>
