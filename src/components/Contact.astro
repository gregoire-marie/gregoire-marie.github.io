---
interface SocialLink { label: string; url: string; icon: string; format?: 'svg'; }
const links: SocialLink[] = [
  { label: 'GitHub', url: 'https://github.com/gregoire-marie', icon: 'jjxzcivr' },
  { label: 'LinkedIn', url: 'https://www.linkedin.com/in/gregoire-marie/', icon: 'euybrknk' },
  { label: 'Scholar', url: 'https://scholar.google.com/citations?user=7MH8aUIAAAAJ&hl=en', icon: 'wired/outline/2557-logo-google' },
  { label: 'ORCID', url: 'https://orcid.org/0009-0008-6576-9490', icon: '/icons/orcid.svg', format: 'svg' },
  { label: 'ResearchGate', url: 'https://www.researchgate.net/profile/Gregoire-Marie-2', icon: '/icons/researchgate.svg', format: 'svg' }
];
const email = 'gregoire.marie08@gmail.com';
const isModernIcon = (icon: string) => icon.includes('/');
const iconSrc = (icon: string) => isModernIcon(icon)
  ? `https://media.lordicon.com/icons/${icon}.li`
  : `https://cdn.lordicon.com/${icon}.json`;
---
<section class="section contact" id="contact">
  <div class="container reveal">
    <p class="section-kicker">06 // Contact</p>
    <h2>Interested in my work?</h2>
    <p>Feel free to reach out.</p>
    <div class="email-row">
      <a class="contact-email" href={`mailto:${email}`}>
        <lord-icon src="https://cdn.lordicon.com/ozlkyfxg.json" trigger="morph" class="contact-email-icon"></lord-icon>
        <span>{email}</span>
      </a>
      <button class="copy-email" type="button" aria-label="Copy email address" title="Copy email address" data-email={email}>
        <svg class="copy-symbol" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2v2"/></svg>
        <svg class="copy-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><polyline points="20 6 9 17 4 12"/></svg>
      </button>
    </div>
    <div class="socials">
      {links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer">
          {link.format === 'svg' ? (
            <span class="social-icon social-brand-icon" style={`--social-logo: url('${link.icon}')`} aria-hidden="true"></span>
          ) : (
          <lord-icon
            src={iconSrc(link.icon)}
            trigger={isModernIcon(link.icon) ? 'hover' : 'morph'}
            state={isModernIcon(link.icon) ? 'hover-pinch' : undefined}
            target="a"
            class="social-icon"
          ></lord-icon>
          )}
          <span>{link.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>
<script>
  const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyButton.dataset.email || '');
      copyButton.querySelector<SVGElement>('.copy-symbol')?.setAttribute('hidden', '');
      copyButton.querySelector<SVGElement>('.copy-check')?.removeAttribute('hidden');
      copyButton.classList.add('copied');
      setTimeout(() => {
        copyButton.querySelector<SVGElement>('.copy-symbol')?.removeAttribute('hidden');
        copyButton.querySelector<SVGElement>('.copy-check')?.setAttribute('hidden', '');
        copyButton.classList.remove('copied');
      }, 1800);
    } catch {}
  });
</script>
